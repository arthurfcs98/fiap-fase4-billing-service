NODE_ENV=development
PORT=3002

# Postgres (billing_db no docker-compose raiz)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=billing_db
DB_SSL=false

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Mercado Pago (test / sandbox) — pegar em https://www.mercadopago.com.br/developers
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
# URL publica pra receber webhook do MP (ex: ngrok em dev, API Gateway em prod)
MP_NOTIFICATION_URL=http://localhost:3002/api/webhooks/mercadopago
# URLs pra onde o MP redireciona apos pagamento
MP_SUCCESS_URL=http://localhost:3002/api/quotes/callback/success
MP_FAILURE_URL=http://localhost:3002/api/quotes/callback/failure
MP_PENDING_URL=http://localhost:3002/api/quotes/callback/pending

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fiap-fase4-billing-service
